# Copy this file to ".env" and fill in your key (the .env file is git-ignored).
# Get a key from Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional overrides:
# GEMINI_MODEL=gemini-2.5-flash

# Jira Cloud integration (create an API token at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# AIO Tests for Jira (test management app) — generate an API key inside AIO Tests
AIO_API_KEY=
# AIO_BASE_URL=https://tcms.aiojiraapps.com/aio-tests/api/v1
